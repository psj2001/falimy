rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function normalizeEmail(email) {
      return email == null ? '' : email.lower();
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Invitee may attach memberLinks when accepting an invite.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberLinks']);
    }

    match /invites/{inviteId} {
      allow read: if signedIn() && (
        resource.data.inviterUserId == request.auth.uid
        || normalizeEmail(resource.data.inviteeEmail)
            == normalizeEmail(request.auth.token.email)
      );

      allow create: if signedIn()
        && request.resource.data.inviterUserId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.inviteeEmail is string
        && request.resource.data.memberKey is string
        && request.resource.data.memberName is string;

      // Inviter can refresh pending invite fields.
      allow update: if signedIn()
        && resource.data.inviterUserId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.inviterUserId == resource.data.inviterUserId
        && request.resource.data.inviteeEmail == resource.data.inviteeEmail
        && request.resource.data.memberKey == resource.data.memberKey;

      // Invitee may accept a pending invite addressed to their email.
      allow update: if signedIn()
        && normalizeEmail(resource.data.inviteeEmail)
            == normalizeEmail(request.auth.token.email)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedUserId == request.auth.uid
        && request.resource.data.inviteeEmail == resource.data.inviteeEmail
        && request.resource.data.inviterUserId == resource.data.inviterUserId
        && request.resource.data.memberKey == resource.data.memberKey;

      allow delete: if false;
    }
  }
}
