PORT=3000
# true = no Homebrew/Atlas needed (data resets on restart)
USE_MEMORY_MONGO=true
MONGODB_URI=mongodb://127.0.0.1:27017/falimy
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# Free email via SMTP (Gmail App Password recommended)
# 1. Enable 2FA on Google → create an App Password
# 2. Or use Brevo / Mailjet free SMTP instead
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Falimy <your-gmail@gmail.com>"

# When SMTP is unset, OTP is logged + returned as devOtp for local testing.
# Set true to always include devOtp in API responses (never in production).
MAIL_DEV_EXPOSE_OTP=false
